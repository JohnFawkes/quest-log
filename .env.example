# --- Security ---

# Generate a random string for this (e.g. openssl rand -hex 32)

SECRET_KEY=change_this_to_a_long_random_string

# --- Google Authentication ---

# Get these from Google Cloud Console -> APIs & Services -> Credentials

GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# --- Notifications ---

# See Apprise documentation for supported services: https://github.com/caronc/apprise

# Discord Example: discord://webhook_id/webhook_token

# Telegram Example: tgram://bot_token/chat_id

# Multiple URLs can be comma separated

APPRISE_URLS=discord://webhook_id/webhook_token

# --- App Configuration ---

# The email address that automatically gets Admin rights on login

ADMIN_EMAIL=admin@example.com

# The public URL of your app (used for Google Redirects)

# No trailing slash.

PUBLIC_DOMAIN=http://localhost:5000

# Port the application listens on

PORT=5000

# Timezone (IANA format, e.g. America/New_York, Europe/London)

TZ=UTC
